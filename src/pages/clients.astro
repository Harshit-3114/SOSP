---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Clients" description="Shree Om Sai Packaging serves the cable industry with high-quality steel cable drums. 450-500 MT capacity, ISO 9001 & ZED Gold certified." canonical="https://www.sospackaging.com/clients">

  <!-- Hero -->
  <section class="relative w-full h-[55vh] min-h-[350px] flex items-center justify-center overflow-hidden bg-primary">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/actual/hero_6.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-dark/80 to-primary/80"></div>
    <div class="relative z-10 text-center px-4 md:px-8 max-w-[1280px] mx-auto">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 drop-shadow-lg">Our Esteemed Clients</h1>
      <p class="text-lg md:text-xl text-surface-gray max-w-2xl mx-auto drop-shadow-md leading-relaxed">
        Trusted by industry leaders for reliable, eco-friendly steel packaging solutions
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-24 px-4 md:px-8 max-w-[1280px] mx-auto">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-sm uppercase tracking-widest text-primary-container font-semibold block mb-2">Who We Serve</span>
        <h2 class="text-3xl md:text-4xl font-bold text-primary">Trusted by the Cable Industry</h2>
      </div>
      <div class="prose max-w-none">
        <p class="text-lg text-on-surface-variant leading-relaxed mb-6">
          We take pleasure in introducing ourselves as a leading steel cable drum manufacturing company. Our monthly manufacturing capacity is 450-500 metric tonnes and a daily production capacity of 45-50 drums per day. We are an ISO 9001 & ZED Gold certified company.
        </p>
        <p class="text-lg text-on-surface-variant leading-relaxed mb-12">
          We manufacture drums as per customer specifications & requirements. We manufacture drums at the most optimum weights and have replaced many wooden drums by our low weight drums matching the cost of wooden drums.
        </p>
      </div>

      <div class="bg-surface-gray rounded-xl p-10 md:p-12 border border-border-gray">
        <h3 class="text-xl font-bold text-primary mb-8">Why Leading Companies Choose Us</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">verified</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">ISO 9001 Certified</span>
              <span class="text-sm text-on-surface-variant">Certified from TUV Rheinland</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">factory</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">450-500 MT Capacity</span>
              <span class="text-sm text-on-surface-variant">Monthly manufacturing capacity</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">inventory_2</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">45-50 Drums Daily</span>
              <span class="text-sm text-on-surface-variant">Daily production capacity</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">design_services</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">Custom Manufacturing</span>
              <span class="text-sm text-on-surface-variant">As per customer specifications</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">eco</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">Eco-Friendly</span>
              <span class="text-sm text-on-surface-variant">Replacing traditional wooden drums</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-surface-container-lowest rounded-lg">
            <span class="material-symbols-outlined text-primary-container mt-1" style="font-variation-settings: 'FILL' 1;">monetization_on</span>
            <div>
              <span class="font-semibold text-primary text-sm block mb-1">Cost Effective</span>
              <span class="text-sm text-on-surface-variant">Optimum weight matching wood cost</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 md:py-24 px-4 md:px-8 bg-surface-gray">
    <div class="max-w-[1280px] mx-auto">
      <div class="text-center mb-12">
        <span class="text-sm uppercase tracking-widest text-primary font-semibold block mb-2">Our Partners</span>
        <h2 class="text-3xl md:text-4xl font-bold text-primary">Our Esteemed Clients</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/havells.png" alt="Havells" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Havells</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/kei.png" alt="KEI (Wires and Cables)" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">KEI (Wires and Cables)</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/universal.png" alt="Unistar Universal Cables Ltd." class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Unistar Universal Cables Ltd.</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/gemscab.png" alt="Gemscab Cables" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Gemscab Cables</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/sriram.png" alt="SC Sriram" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">SC Sriram</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/cords.png" alt="Cords" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Cords</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/venwires.png" alt="Venkateshvara Wires (P) Ltd." class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Venkateshvara Wires (P) Ltd.</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/anamika.png" alt="Anamika" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Anamika</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/oswal.png" alt="Oswal Cables" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Oswal Cables</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/olympic.svg" alt="OC (Olympic Cables)" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">OC (Olympic Cables)</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/finolex.png" alt="Finolex J-Power Systems Ltd." class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Finolex J-Power Systems Ltd.</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/neelkanth.png" alt="Neelkanth Cables" class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">Neelkanth Cables</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-6 flex flex-col items-center justify-center gap-3 hover:shadow-md hover:-translate-y-1 transition-all duration-300">
          <img src="/images/actual/clients/lscables.png" alt="LS Cables India Pvt. Ltd." class="h-12 w-auto object-contain" />
          <span class="text-sm font-semibold text-primary text-center">LS Cables India Pvt. Ltd.</span>
        </div>
      </div>
    </div>
  </section>
</Layout>
