---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cabreel" description="Cabreel - Precision steel cable drums, a sister company of Shree Om Sai Packaging. Based in Matsya Industrial Area, Alwar, Rajasthan." canonical="https://www.sospackaging.com/cabreel">

  <!-- Hero Banner -->
  <section class="relative w-full h-[55vh] min-h-[350px] flex items-center justify-center overflow-hidden bg-primary">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/actual/hero_3.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-dark/80 to-primary/80"></div>
    <div class="relative z-10 text-center px-4 md:px-8 max-w-[1280px] mx-auto">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-white text-xs uppercase tracking-widest font-semibold mb-6 shadow-lg backdrop-blur-sm">
        <span class="material-symbols-outlined text-sm">precision_manufacturing</span>
        Sister Company
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 drop-shadow-lg">Cabreel Drums</h1>
      <p class="text-lg md:text-xl text-surface-gray max-w-2xl mx-auto drop-shadow-md leading-relaxed">
        Precision steel cable drums for dispatch and process applications
      </p>
    </div>
  </section>

  <!-- Sister Company: Cabreel -->
  <section class="py-24 px-4 md:px-8 max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5 relative">
        <div class="absolute -inset-4 bg-surface-container-high rounded-xl -rotate-3 z-0"></div>
        <div class="relative z-10 bg-surface-container-low rounded-xl h-80 flex items-center justify-center shadow-md border border-border-gray overflow-hidden">
          <img src="/images/actual/hero_3.webp" alt="Cabreel manufacturing facility" class="absolute inset-0 w-full h-full object-cover" />
        </div>
      </div>
      <div class="md:col-span-7 md:pl-8">
        <span class="text-sm uppercase tracking-widest text-primary-container font-semibold">Sister Company</span>
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">Cabreel Drums</h2>
        <div class="w-16 h-1 bg-success-green mb-8"></div>
        <p class="text-lg text-on-surface-variant mb-6 leading-relaxed">
          Cabreel is a dedicated steel cable drum manufacturing unit and a sister company of <strong class="text-primary font-semibold">Shree Om Sai Packaging (SOSP)</strong>. Based in the Matsya Industrial Area of Alwar, Rajasthan, Cabreel brings the same legacy of quality, precision, and sustainable manufacturing that SOSP is known for.
        </p>
        <p class="text-lg text-on-surface-variant mb-8 leading-relaxed">
          Specializing in heavy-duty steel cable drums for dispatch and process applications, Cabreel serves the industrial cabling and wire sectors with robust packaging solutions designed for safety, durability, and reusability.
        </p>
        <p class="text-lg text-on-surface-variant leading-relaxed">
          Cabreel has planted 11 trees on our managing partner Amit Shyamsukha's birthday in the developed and maintained garden at Cabreel, reflecting our commitment to environmental stewardship.
        </p>
      </div>
    </div>
  </section>

  <!-- Cabreel Contact -->
  <section class="py-24 px-4 md:px-8 bg-surface-gray">
    <div class="max-w-[1280px] mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary">Get in Touch with Cabreel</h2>
        <p class="text-lg text-on-surface-variant mt-4 max-w-2xl mx-auto leading-relaxed">Reach out directly for inquiries, quotations, and technical specifications.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center max-w-4xl mx-auto">
        <div class="bg-surface-container-lowest rounded-xl border border-border-gray p-10 shadow-sm">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-white shrink-0">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Address</div>
                <div class="text-sm font-semibold text-primary">SP-8(O), M.I.A., Alwar, Rajasthan</div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-white shrink-0">
                <span class="material-symbols-outlined">call</span>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Phone</div>
                <a href="tel:7976122394" class="text-sm font-semibold text-primary hover:text-primary-container transition-colors">7976122394</a>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-white shrink-0">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Email</div>
                <a href="mailto:cabreeldrums@gmail.com" class="text-sm font-semibold text-primary hover:text-primary-container transition-colors">cabreeldrums@gmail.com</a>
              </div>
            </div>
          </div>
        </div>
        <div class="text-center md:text-left">
          <h2 class="text-2xl md:text-3xl font-bold text-primary mb-4">Part of the Shree Om Sai Packaging Group</h2>
          <p class="text-lg text-on-surface-variant leading-relaxed">
            Cabreel operates under the same management as Shree Om Sai Packaging, sharing a commitment to quality, sustainability, and industrial excellence.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    document.body.setAttribute("data-page", "cabreel");
  });
</script>
