---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Page Not Found | Shree Om Sai Packaging" description="The page you are looking for does not exist." canonical="https://www.sospackaging.com/404">

  <section class="py-32 px-4 md:px-8 max-w-[1280px] mx-auto flex flex-col items-center justify-center text-center min-h-[60vh]">
    <span class="text-8xl md:text-9xl font-extrabold text-primary-container/20 select-none">404</span>
    <h1 class="text-3xl md:text-4xl font-bold text-primary mt-6 mb-4">Page Not Found</h1>
    <p class="text-lg text-on-surface-variant max-w-md mb-10 leading-relaxed">
      The page you are looking for might have been moved, deleted, or never existed.
    </p>
    <a href="/" class="bg-success-green text-white font-semibold uppercase tracking-wider px-8 py-4 rounded hover:bg-primary transition-all duration-200 text-sm">
      Back to Home
    </a>
  </section>
</Layout>
