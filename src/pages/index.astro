<script>
  const Q_SCRIPT_ID = import.meta.env.PUBLIC_GAS_SCRIPT_ID;
  const Q_GAS_URL = Q_SCRIPT_ID ? `https://script.google.com/macros/s/${Q_SCRIPT_ID}/exec` : null;
  const Q_MIN_INTERVAL = 5000;

  function qSanitize(str) {
    if (typeof str !== "string") return "";
    return str.replace(/<[^>]*>/g, "").trim();
  }

  function qIsValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  let qLastSubmit = 0;

  document.getElementById("quote-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const now = Date.now();
    if (now - qLastSubmit < Q_MIN_INTERVAL) return;

    const form = e.target;
    const status = document.getElementById("quote-form-status");
    const btn = form.querySelector('button[type="submit"]');

    if (!Q_GAS_URL) {
      status.textContent = "Form is not yet configured. Please email us directly at info@sospackaging.com";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    const raw = new FormData(form);
    const email = qSanitize(raw.get("email") || "");
    if (!qIsValidEmail(email)) {
      status.textContent = "Please enter a valid email address.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    if (!qSanitize(raw.get("name") || "")) {
      status.textContent = "Please enter your name.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    if (!qSanitize(raw.get("message") || "")) {
      status.textContent = "Please enter a message.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Sending...";
    status.classList.add("hidden");
    qLastSubmit = now;

    for (const [key] of raw.entries()) {
      if (key === "consent" || key === "attachment") continue;
      const val = raw.get(key);
      if (typeof val === "string") raw.set(key, qSanitize(val));
    }

    try {
      const res = await fetch(Q_GAS_URL, {
        method: "POST",
        body: raw,
      });
      if (res.ok) {
        status.textContent = "Thanks for submitting! We'll get back to you shortly.";
        status.className = "text-sm text-green-600 text-center";
        form.reset();
      } else {
        throw new Error("Failed");
      }
    } catch {
      status.textContent = "Something went wrong. Please email us directly at info@sospackaging.com";
      status.className = "text-sm text-red-600 text-center";
    }
    status.classList.remove("hidden");
    btn.disabled = false;
    btn.textContent = "Request a Quote";
  });

  const iParams = new URLSearchParams(window.location.search);
  const iProduct = iParams.get("product");
  if (iProduct) {
    const iCheckbox = document.querySelector(`#quote-form input[name="unit-type"][value="${iProduct}"]`);
    if (iCheckbox) iCheckbox.checked = true;
  }
</script>
