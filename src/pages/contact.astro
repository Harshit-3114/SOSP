---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us" description="Get in touch with Shree Om Sai Packaging. Call 0144-2881561 or email info@sospackaging.com. Located in Alwar, Rajasthan." canonical="https://www.sospackaging.com/contact">

  <!-- Hero -->
  <section class="relative w-full h-[55vh] min-h-[350px] flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary to-neutral-dark">
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-dark/60 to-primary/60"></div>
    <div class="relative z-10 text-center px-4 md:px-8 max-w-[1280px] mx-auto">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 drop-shadow-lg">Contact Us</h1>
      <p class="text-lg md:text-xl text-surface-gray max-w-2xl mx-auto drop-shadow-md leading-relaxed">
        Get in touch for inquiries, quotes, or custom engineering requirements
      </p>
    </div>
  </section>

  <!-- Map -->
  <section class="w-full">
    <div class="w-full h-[400px]">
      <iframe
        src="https://www.google.com/maps?q=Shree+Om+Sai+Packaging+Alwar&output=embed"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="Shree Om Sai Packaging Location"
      ></iframe>
    </div>
  </section>

  <!-- Contact Info + Form -->
  <section class="py-16 md:py-24 px-4 md:px-8 max-w-[1280px] mx-auto">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-border-gray overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-5">
        <!-- Contact Info -->
        <div class="order-2 lg:order-1 lg:col-span-2 bg-surface-container-low p-6 md:p-10 flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold text-primary mb-4">Let's Discuss Your Packaging Needs</h2>
            <p class="text-base text-on-surface-variant mb-12 leading-relaxed">
              Provide us with your technical specifications, and our engineering team will provide a tailored, sustainable steel packaging solution.
            </p>
            <div class="space-y-6">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined">location_on</span>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Address</div>
                  <div class="text-sm font-semibold text-primary">Plot No. F-596, M.I.A. Extension<br/>Alwar - 301030, Rajasthan</div>
                  <div class="text-sm text-on-surface-variant mt-2">Unit 2: Plot No B-65 (A), M.I.A., Alwar-301030</div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined">mail</span>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Email</div>
                  <div class="text-sm font-semibold text-primary">
                    <a href="mailto:info@sospackaging.com" class="hover:text-primary-container transition-colors inline-block py-1">info@sospackaging.com</a><br/>
                    <a href="mailto:amitshyamsukha@sospackaging.com" class="hover:text-primary-container transition-colors inline-block py-1">amitshyamsukha@sospackaging.com</a>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined">call</span>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Phone</div>
                  <div class="text-sm font-semibold text-primary">
                    <a href="tel:01442881561" class="hover:text-primary-container transition-colors inline-block py-1">0144 - 2881561</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-border-gray pt-6 mt-6">
              <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-primary-container text-sm">group_work</span>
                <span class="text-xs uppercase tracking-widest text-outline font-semibold">Sister Company: Cabreel</span>
              </div>
              <div class="space-y-4">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined">location_on</span>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Address</div>
                    <div class="text-sm font-semibold text-primary">SP-8(O), M.I.A.,<br/>Alwar, Rajasthan</div>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined">call</span>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Phone</div>
                    <a href="tel:7976122394" class="text-sm font-semibold text-primary hover:text-primary-container transition-colors inline-block py-1">7976122394</a>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined">mail</span>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-outline font-semibold mb-1">Email</div>
                    <a href="mailto:cabreeldrums@gmail.com" class="text-sm font-semibold text-primary hover:text-primary-container transition-colors break-all inline-block py-1">cabreeldrums@gmail.com</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="order-1 lg:order-2 lg:col-span-3 p-6 md:p-10">
          <form id="contact-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="company">Company Name <span class="text-outline font-normal normal-case">(optional)</span></label>
                <input id="company" name="company" type="text" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="Your company" />
              </div>
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="designation">Designation <span class="text-outline font-normal normal-case">(optional)</span></label>
                <input id="designation" name="designation" type="text" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="Your role" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="name">Your Name *</label>
                <input id="name" name="name" type="text" required class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="Your name" />
              </div>
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="email">Email Address *</label>
                <input id="email" name="email" type="email" required class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="your@email.com" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="phone">Phone <span class="text-outline font-normal normal-case">(optional)</span></label>
                <input id="phone" name="phone" type="tel" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="Your phone number" />
              </div>
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="subject">Subject</label>
                <input id="subject" name="subject" type="text" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="e.g. Quotation request for steel drums" />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="hear-about">How did you hear about us? <span class="text-outline font-normal normal-case">(optional)</span></label>
                <select id="hear-about" name="hear-about" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all">
                  <option value="">Select an option</option>
                  <option value="google">Google Search</option>
                  <option value="linkedin">LinkedIn</option>
                  <option value="trade-show">Trade Show / Exhibition</option>
                  <option value="referral">Referral</option>
                  <option value="social-media">Social Media</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="contact-time">Preferred Contact Time *</label>
                <select id="contact-time" name="contact-time" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all">
                  <option value="">Select preferred time</option>
                  <option value="morning">Morning (9:00 AM - 12:00 PM)</option>
                  <option value="afternoon">Afternoon (12:00 PM - 3:00 PM)</option>
                  <option value="evening">Evening (3:00 PM - 6:00 PM)</option>
                  <option value="anytime">Anytime</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="quantity">Estimated Quantity / Volume <span class="text-outline font-normal normal-case">(optional)</span></label>
                <select id="quantity" name="quantity" class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all">
                <option value="">Select approximate quantity</option>
                <option value="trial">Trial (1-5 drums)</option>
                <option value="small">Small Batch (5-20 drums)</option>
                <option value="medium">Medium Order (20-100 drums)</option>
                <option value="large">Large Order (100+ drums)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs uppercase text-primary font-semibold mb-3 tracking-wider">Preferred Unit Type</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="flex items-center gap-3 p-3 rounded-lg border border-border-gray bg-surface-bright hover:bg-surface-container-low transition-colors cursor-pointer has-[:checked]:border-primary-container has-[:checked]:bg-primary-container/5">
                  <input type="checkbox" name="unit-type" value="corrugated-steel-cable-drum" class="accent-primary-container w-5 h-5 shrink-0" />
                  <span class="text-sm font-medium text-primary">Corrugated Steel Cable Drum</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-lg border border-border-gray bg-surface-bright hover:bg-surface-container-low transition-colors cursor-pointer has-[:checked]:border-primary-container has-[:checked]:bg-primary-container/5">
                  <input type="checkbox" name="unit-type" value="process-drum" class="accent-primary-container w-5 h-5 shrink-0" />
                  <span class="text-sm font-medium text-primary">Process Drum</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-lg border border-border-gray bg-surface-bright hover:bg-surface-container-low transition-colors cursor-pointer has-[:checked]:border-primary-container has-[:checked]:bg-primary-container/5">
                  <input type="checkbox" name="unit-type" value="ms-tie-rod" class="accent-primary-container w-5 h-5 shrink-0" />
                  <span class="text-sm font-medium text-primary">M.S Tie Rod</span>
                </label>
                <label class="flex items-center gap-3 p-3 rounded-lg border border-border-gray bg-surface-bright hover:bg-surface-container-low transition-colors cursor-pointer has-[:checked]:border-primary-container has-[:checked]:bg-primary-container/5">
                  <input type="checkbox" name="unit-type" value="hybrid-drum" class="accent-primary-container w-5 h-5 shrink-0" />
                  <span class="text-sm font-medium text-primary">Hybrid Drum</span>
                </label>
              </div>
            </div>
            <div>
              <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="message">Technical Specifications / Message *</label>
              <textarea id="message" name="message" rows="5" required class="w-full bg-surface-bright border border-border-gray rounded px-4 py-3 sm:py-4 text-base focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary-container transition-all" placeholder="Please provide details regarding dimensions, load capacity, or specific requirements..."></textarea>
            </div>
            <div>
              <label class="block text-xs uppercase text-primary font-semibold mb-2 tracking-wider" for="attachment">Attach Reference Drawing / Spec Sheet <span class="text-outline font-normal normal-case">(optional)</span></label>
               <input id="attachment" name="attachment" type="file" accept=".pdf,.dxf,.dwg,.jpg,.png" class="w-full text-sm text-on-surface-variant file:mr-4 file:py-3 file:px-5 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary-container file:text-white hover:file:bg-primary file:cursor-pointer transition-all cursor-pointer" />
              <p class="text-xs text-outline mt-1">Accepted: PDF, DXF, DWG, JPG, PNG</p>
            </div>
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="consent" required class="accent-primary-container w-5 h-5 mt-0.5 shrink-0" />
              <span class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">I consent to Shree Om Sai Packaging contacting me about my inquiry and confirm I have read the <a href="/privacy" class="text-primary hover:text-primary-container underline">Privacy Policy</a>. *</span>
            </label>
            <button type="submit" class="bg-success-green text-white font-semibold uppercase tracking-wider px-8 py-4 rounded hover:bg-primary transition-all duration-200 w-full md:w-auto text-sm">
              Send Message
            </button>
            <p id="form-status" class="text-sm text-center hidden"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const SCRIPT_ID = import.meta.env.PUBLIC_GAS_SCRIPT_ID;
  const GAS_URL = SCRIPT_ID ? `https://script.google.com/macros/s/${SCRIPT_ID}/exec` : null;
  const MIN_SUBMIT_INTERVAL = 5000;

  function sanitize(str) {
    if (typeof str !== "string") return "";
    return str.replace(/<[^>]*>/g, "").trim();
  }

  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  let lastSubmit = 0;

  document.getElementById("contact-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const now = Date.now();
    if (now - lastSubmit < MIN_SUBMIT_INTERVAL) return;

    const form = e.target;
    const status = document.getElementById("form-status");
    const btn = form.querySelector('button[type="submit"]');

    if (!GAS_URL) {
      status.textContent = "Form is not yet configured. Please email us directly at info@sospackaging.com";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    const raw = new FormData(form);
    const email = sanitize(raw.get("email") || "");
    if (!isValidEmail(email)) {
      status.textContent = "Please enter a valid email address.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    if (!sanitize(raw.get("name") || "")) {
      status.textContent = "Please enter your name.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    if (!sanitize(raw.get("message") || "")) {
      status.textContent = "Please enter a message.";
      status.className = "text-sm text-red-600 text-center";
      status.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Sending...";
    status.classList.add("hidden");
    lastSubmit = now;

    for (const [key] of raw.entries()) {
      if (key === "consent" || key === "attachment") continue;
      const val = raw.get(key);
      if (typeof val === "string") raw.set(key, sanitize(val));
    }

    try {
      const res = await fetch(GAS_URL, {
        method: "POST",
        body: raw,
      });
      if (res.ok) {
        status.textContent = "Thanks for submitting! We'll get back to you shortly.";
        status.className = "text-sm text-green-600 text-center";
        form.reset();
      } else {
        throw new Error("Failed");
      }
    } catch {
      status.textContent = "Something went wrong. Please email us directly at info@sospackaging.com";
      status.className = "text-sm text-red-600 text-center";
    }
    status.classList.remove("hidden");
    btn.disabled = false;
    btn.textContent = "Send Message";
  });

  const params = new URLSearchParams(window.location.search);
  const product = params.get("product");
  if (product) {
    const checkbox = document.querySelector(`input[name="unit-type"][value="${product}"]`);
    if (checkbox) checkbox.checked = true;
    const formSection = document.getElementById("contact-form");
    if (formSection) formSection.scrollIntoView({ behavior: "smooth", block: "center" });
  }
</script>
