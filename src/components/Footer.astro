---

<footer class="bg-primary text-on-primary">
  <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-start">
      <div class="max-w-xs mx-auto md:mx-0 text-center md:text-left">
        <a href="/" class="inline-flex items-center gap-2 mb-4" aria-label="Home">
          <img src="/images/actual/sosp logo.webp" alt="SOSP Logo" class="h-9 w-auto" />
        </a>
        <p class="text-sm text-on-primary/80 leading-relaxed mb-6">
          Sustainable industrial steel packaging solutions engineered for a greener future.
        </p>
        <div class="flex gap-3">
          <a
            href="tel:01442881561"
            class="w-12 h-12 bg-primary-container hover:bg-primary text-white rounded-full flex items-center justify-center shadow-lg transition-colors"
            aria-label="Call us at 0144 - 2881561"
          >
            <span class="material-symbols-outlined">call</span>
          </a>
          <a
            href="mailto:info@sospackaging.com"
            class="w-12 h-12 bg-success-green hover:bg-primary text-white rounded-full flex items-center justify-center shadow-lg transition-colors"
            aria-label="Email us at info@sospackaging.com"
          >
            <span class="material-symbols-outlined">mail</span>
          </a>
        </div>
      </div>
      <div class="flex flex-col items-center md:items-start justify-center mx-auto">
        <div class="flex flex-col gap-4 items-center md:items-start">
          <a href="/profile" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">About Us</a>
          <a href="/products" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Products</a>
          <a href="/gallery" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Gallery</a>
          <a href="/clients" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Clients</a>
          <a href="/contact" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Contact</a>
          <a href="/faq" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">FAQ</a>
          <a href="/terms" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Terms</a>
          <a href="/privacy" class="text-sm text-on-primary/80 hover:text-white transition-colors py-1">Privacy</a>
        </div>
      </div>
      <div class="flex flex-col items-center md:items-end">
        <div class="w-full max-w-[300px] h-40 rounded-lg overflow-hidden border border-white/10">
          <iframe
            src="https://www.google.com/maps?q=Shree+Om+Sai+Packaging+Alwar&output=embed"
            width="300"
            height="160"
            style="border:0;max-width:100%;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Shree Om Sai Packaging Location"
          ></iframe>
        </div>
        <p class="text-xs text-on-primary/60 mt-2">Alwar, Rajasthan, India</p>
      </div>
    </div>
    <div class="border-t border-white/20 mt-12 pt-8 text-sm text-on-primary/60 text-center">
      <p>&copy; {new Date().getFullYear()} Shree Om Sai Packaging. All rights reserved.</p>
    </div>
  </div>
</footer>
